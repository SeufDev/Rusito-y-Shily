# Copiá este archivo como .env.local y completá con los datos de Supabase
# (Project Settings → API). La "anon key" es pública por diseño: la seguridad la da la clave de ustedes + RLS.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# El email de la cuenta compartida que crean en Supabase (Authentication → Users → Add user)
VITE_SHARED_EMAIL=nosotros@rusitoyshily.love
