# Copiá este archivo como .env.local y completá con los datos de Supabase
# (Project Settings → API). La "anon key" es pública por diseño: la seguridad la dan sus claves + las reglas de la base.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Los emails de las dos cuentas (Authentication → Users → Add user). Cada una con su propia clave.
VITE_EMAIL_SHILY=shily@rusitoyshily.love
VITE_EMAIL_RUSITO=rusito@rusitoyshily.love
